[Unit]
Description=Install vendor-default flatpaks
Wants=network-online.target
After=network-online.target
ConditionPathExistsGlob=/etc/flatpak/preinstall.d/*.preinstall

[Service]
Type=oneshot
ExecStart=/usr/bin/dbus-run-session /usr/bin/flatpak preinstall --system -y --noninteractive
RemainAfterExit=yes
TimeoutStartSec=30min

[Install]
WantedBy=multi-user.target
